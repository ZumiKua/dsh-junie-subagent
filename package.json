{
  "name": "@zumikua/dsh-junie-subagent",
  "version": "0.1.3",
  "publishConfig": {
    "access": "public"
  },
  "description": "JetBrains Junie CLI as a one-shot DeepSeek Harness subagent provider over the Agent Client Protocol, with a settings page for model and thinking depth.",
  "type": "module",
  "license": "MIT",
  "author": "Zumi Kua",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "junie",
    "jetbrains",
    "subagent",
    "acp",
    "agent-client-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZumiKua/dsh-junie-subagent.git"
  },
  "homepage": "https://github.com/ZumiKua/dsh-junie-subagent#readme",
  "bugs": {
    "url": "https://github.com/ZumiKua/dsh-junie-subagent/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "helpers.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
